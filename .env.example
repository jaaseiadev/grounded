# Supabase project (required)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-with-your-publishable-key
SUPABASE_SECRET_KEY=replace-with-your-secret-key
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-service-role-key
SUPABASE_STORAGE_BUCKET=documents

# OpenRouter (required, backend only)
OPENROUTER_API_KEY=replace-with-your-openrouter-api-key
OPENROUTER_CHAT_MODEL=stealth/ox-alpha
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
OPENROUTER_REASONING_EFFORT=medium
OPENROUTER_MAX_COMPLETION_TOKENS=4096
OPENROUTER_SITE_URL=http://localhost:4200
OPENROUTER_APP_NAME=Grounded

# API runtime
FRONTEND_URL=http://localhost:4200
PORT=3000
